---
import { getAllProjects } from '../data/projects.js';
const projects = [...getAllProjects()].sort((a, b) =>
  b.startDate.localeCompare(a.startDate) || a.title.localeCompare(b.title),
);
---
<section id="projects" class="content-section" aria-labelledby="projects-title">
  <div class="section-heading"><h2 id="projects-title">Projects</h2></div>
  <ul class="entry-list project-list">
    {projects.map((project) => (
      <li class="project-entry">
        <div class="entry-topline">
          <h3><a href={project.links.website || project.links.github} target="_blank" rel="noopener noreferrer">{project.title}</a></h3>
          <span class="entry-year">{project.startDate.slice(0, 4)}</span>
        </div>
        <p>{project.shortDescription}</p>
        <div class="entry-links">
          {project.links.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">Code</a>}
          {project.links.paper && <a href={project.links.paper} target="_blank" rel="noopener noreferrer">Paper</a>}
          {project.links.demo && project.links.demo !== project.links.website && <a href={project.links.demo} target="_blank" rel="noopener noreferrer">Demo</a>}
        </div>
      </li>
    ))}
  </ul>
</section>
