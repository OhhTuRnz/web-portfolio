---
import { site } from '../data/site';
---
<section id="hero" class="intro" aria-labelledby="intro-title">
  <h1 id="intro-title">{site.name}</h1>
  <div class="intro-body">
    <div class="intro-copy">
      <p class="intro-lede">
        A little about me and my work.
      </p>
      <p>
        I am an MS student on the PhD track in Aeronautics and Astronautics at
        <a href="https://aeroastro.mit.edu" target="_blank" rel="noopener noreferrer">MIT AeroAstro</a>,
        working at <a href="https://aeroastro.mit.edu/arclab/" target="_blank" rel="noopener noreferrer">ARCLab</a>.
      </p>
      <div class="intro-links">
        <a href="/assets/CarruskCV.pdf" target="_blank" rel="noopener noreferrer">Curriculum vitae</a>
      </div>
    </div>
    <img class="portrait" src="/assets/images/carrusk_zen.webp" alt="Alejandro Carrasco"
      width="112" height="150" loading="eager" fetchpriority="high" />
  </div>
</section>
