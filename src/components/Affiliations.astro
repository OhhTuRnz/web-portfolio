---
// Chronological order (earliest first) — read left-to-right like a flight
// path on desktop, top-to-bottom on mobile.
const affiliations = [
  {
    name: 'ETSISI - Universidad Politécnica de Madrid',
    shortName: 'ETSISI · UPM',
    logo: '/assets/logos/etsisi-logo.png',
    role: 'B.S. Software Engineering',
    period: '2020 – 2023',
    link: 'https://etsisi.upm.es',
    current: false
  },
  {
    name: 'MIT Astrodynamics, Space Robotics, and Controls Lab (ARC Lab)',
    shortName: 'MIT ARC Lab',
    logo: '/assets/logos/mit-arclab-logo.jpg',
    role: 'Research Assistant',
    period: '2024 – Present',
    link: 'https://aeroastro.mit.edu/arclab/',
    current: true
  },
  {
    name: 'Massachusetts Institute of Technology',
    shortName: 'MIT',
    logo: '/assets/logos/MIT_logo.svg',
    role: "Master's Student, PhD track",
    period: '2025 – Present',
    link: 'https://mit.edu',
    current: true
  }
];
---

<section id="affiliations" class="arclab-section">
  <div class="arclab-container">
    <div class="aff-header text-center arclab-fade-in">
      <h2 class="arclab-heading-2 mb-1">Trajectory</h2>
      <p class="arclab-text text-sm opacity-60">Academic &amp; research path, MIT ARC Lab, MIT AeroAstro</p>
    </div>

    <div class="aff-track-wrap arclab-fade-in" style="animation-delay: 0.15s;">
      <div class="aff-track">
        <div class="aff-line" aria-hidden="true"></div>
        {affiliations.map((aff) => (
          <a
            href={aff.link}
            target="_blank"
            rel="noopener noreferrer"
            class="aff-waypoint"
            aria-label={`${aff.name} — ${aff.role}, ${aff.period}`}
          >
            <span class="aff-node">
              <img src={aff.logo} alt="" class="aff-logo" loading="lazy" decoding="async" />
              {aff.current && <span class="aff-pulse" aria-hidden="true" title="Current"></span>}
            </span>
            <span class="aff-info">
              <span class="aff-name">{aff.shortName}</span>
              <span class="aff-role">{aff.role}</span>
              <span class="aff-period">{aff.period}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .aff-header { margin-bottom: 0.5rem; }

  .aff-track-wrap { padding: 1.5rem 0 0.5rem; }

  .aff-track {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Dashed "flight path" connecting each waypoint — same visual language as
     the awards constellation's orbit-guide ring. */
  .aff-line {
    position: absolute;
    top: 27px;
    left: 8%;
    right: 8%;
    border-top: 1px dashed rgba(255, 255, 255, 0.16);
    z-index: 0;
  }

  .aff-waypoint {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex: 1;
    min-width: 0;
    border-radius: 12px;
    transition: transform 0.25s ease;
  }
  .aff-waypoint:hover,
  .aff-waypoint:focus-visible { transform: translateY(-4px); }
  .aff-waypoint:focus-visible { outline: none; }

  .aff-node {
    position: relative;
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    border-radius: 50%;
    /* Solid light chip, not translucent-dark — several of these logos ship
       as opaque JPGs with their own white background baked in; putting them
       on a dark translucent circle left a mismatched hard-edged patch
       showing through. A consistent light badge is how logos like this are
       normally presented regardless of source format. */
    background: #f1f5f9;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .aff-waypoint:hover .aff-node,
  .aff-waypoint:focus-visible .aff-node {
    border-color: var(--arclab-blue);
    box-shadow: 0 0 16px 2px rgba(245, 158, 11, 0.4);
  }
  .aff-logo { width: 72%; height: 72%; object-fit: contain; }

  /* Live-position blip for current affiliations — a calm breathing glow
     rather than an expanding radar-ping ring (which read as glitchy at this
     size, scaling right over the logo). */
  .aff-pulse {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 2px var(--arclab-primary), 0 0 4px 1px rgba(34, 197, 94, 0.5);
    animation: aff-pulse-glow 2.4s ease-in-out infinite;
  }
  @keyframes aff-pulse-glow {
    0%, 100% { box-shadow: 0 0 0 2px var(--arclab-primary), 0 0 4px 1px rgba(34, 197, 94, 0.45); }
    50%      { box-shadow: 0 0 0 2px var(--arclab-primary), 0 0 8px 2px rgba(34, 197, 94, 0.85); }
  }

  .aff-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.15rem;
  }
  .aff-name { font-size: 0.85rem; font-weight: 600; color: #fff; line-height: 1.3; }
  .aff-role { font-size: 0.72rem; color: #9fb0c3; line-height: 1.4; max-width: 150px; }
  .aff-period {
    font-family: var(--arclab-font-mono);
    font-size: 0.68rem;
    color: #fbbf24;
    letter-spacing: 0.03em;
  }

  @media (prefers-reduced-motion: reduce) {
    .aff-waypoint { transition: none; }
    .aff-pulse { animation: none; }
  }

  /* ── Mobile: vertical flight path ── */
  @media (max-width: 767px) {
    .aff-track {
      flex-direction: column;
      align-items: stretch;
      max-width: 380px;
      gap: 1.75rem;
      padding: 0;
    }
    .aff-line {
      top: 0;
      bottom: 0;
      left: 27px;
      right: auto;
      border-top: none;
      border-left: 1px dashed rgba(255, 255, 255, 0.16);
    }
    .aff-waypoint {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: 1rem;
    }
    .aff-waypoint:hover,
    .aff-waypoint:focus-visible { transform: translateX(4px); }
    .aff-info { align-items: flex-start; text-align: left; }
    .aff-role { max-width: none; }
  }
</style>
