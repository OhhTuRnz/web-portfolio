<canvas class="star-background" data-star-background aria-hidden="true"></canvas>

<script>
  import sky from '../data/sky.json';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-star-background]');
  const context = canvas?.getContext('2d');
  if (canvas && context) startStarfield(canvas, context);

  function startStarfield(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const style = getComputedStyle(document.documentElement);
    const color = style.getPropertyValue('--star-color').trim();
    const lineOpacity = Number(style.getPropertyValue('--constellation-opacity'));
    const stars = sky.stars.map(([x, y, magnitude], index) => {
      const brightness = Math.max(0, Math.min(1, (4.8 - magnitude) / 5));
      return {
        x, y, magnitude,
        radius: 0.65 + brightness * 1.45,
        alpha: 0.34 + brightness * 0.6,
        phase: index * 2.3999632297,
      };
    });
    let visibleStars: typeof stars = [];
    // Cache constellation lines and soft halos; only the star cores twinkle.
    const backdrop = document.createElement('canvas');
    const backdropContext = backdrop.getContext('2d');
    let width = 0;
    let height = 0;
    let frame = 0;
    let lastPaint = 0;
    let nextShootingStar = performance.now() + 6000 + Math.random() * 4000;
    let shootingStar: { x: number; y: number; distance: number; started: number } | undefined;

    function paint(time: number) {
      ctx.clearRect(0, 0, width, height);
      if (backdropContext) ctx.drawImage(backdrop, 0, 0, width, height);
      for (const star of visibleStars) {
        const twinkle = reducedMotion.matches ? 1 : 0.93 + Math.sin(time / 3200 + star.phase) * 0.07;
        ctx.fillStyle = `rgba(${color}, ${star.alpha * twinkle})`;
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
        ctx.fill();
      }
      if (reducedMotion.matches) return;
      if (!shootingStar && time >= nextShootingStar) {
        shootingStar = {
          x: width * (0.05 + Math.random() * 0.5),
          y: height * (0.04 + Math.random() * 0.24),
          distance: Math.min(width * 0.7, 480),
          started: time,
        };
      }
      if (!shootingStar) return;
      const progress = (time - shootingStar.started) / 1700;
      if (progress >= 1) {
        shootingStar = undefined;
        nextShootingStar = time + 16000 + Math.random() * 14000;
        return;
      }
      const point = (t: number) => ({
        x: shootingStar!.x + shootingStar!.distance * t,
        y: shootingStar!.y + shootingStar!.distance * (0.4 * t + 0.12 * t * t),
      });
      const tailProgress = Math.max(0, progress - 0.18);
      const tail = point(tailProgress);
      const head = point(progress);
      if (head.x === tail.x && head.y === tail.y) return;
      const gradient = ctx.createLinearGradient(tail.x, tail.y, head.x, head.y);
      gradient.addColorStop(0, `rgba(${color}, 0)`);
      gradient.addColorStop(1, `rgba(${color}, ${Math.sin(progress * Math.PI) * 0.62})`);
      ctx.strokeStyle = gradient;
      ctx.lineWidth = 1.3;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(tail.x, tail.y);
      for (let i = 1; i <= 8; i++) {
        const p = point(tailProgress + (progress - tailProgress) * i / 8);
        ctx.lineTo(p.x, p.y);
      }
      ctx.stroke();
    }

    function animate(time: number) {
      if (time - lastPaint >= 1000 / 30) {
        paint(time);
        lastPaint = time;
      }
      frame = requestAnimationFrame(animate);
    }
    function stop() {
      cancelAnimationFrame(frame);
      frame = 0;
    }
    function resume() {
      stop();
      shootingStar = undefined;
      nextShootingStar = performance.now() + 6000 + Math.random() * 4000;
      paint(performance.now());
      if (!reducedMotion.matches && !document.hidden) frame = requestAnimationFrame(animate);
    }
    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      // One uniform scale preserves constellation shapes across screen sizes.
      // The horizon circle covers the viewport; its edges are simply cropped.
      const scale = Math.hypot(width, height) / 2;
      const project = ([x, y]: number[]) => ({ x: width / 2 + x * scale, y: height / 2 + y * scale });
      visibleStars = stars.map((star) => ({ ...star, ...project([star.x, star.y]) }))
        .filter(({ x, y }) => x >= -8 && x <= width + 8 && y >= -8 && y <= height + 8);
      backdrop.width = canvas.width;
      backdrop.height = canvas.height;
      if (backdropContext) {
        backdropContext.setTransform(ratio, 0, 0, ratio, 0, 0);
        backdropContext.strokeStyle = `rgba(${color}, ${lineOpacity})`;
        backdropContext.lineWidth = 0.75;
        backdropContext.lineCap = 'round';
        backdropContext.lineJoin = 'round';
        backdropContext.beginPath();
        for (const path of sky.lines) {
          path.forEach((point, index) => {
            const { x, y } = project(point);
            if (index === 0) backdropContext.moveTo(x, y);
            else backdropContext.lineTo(x, y);
          });
        }
        backdropContext.stroke();
        for (const star of visibleStars.filter(({ magnitude }) => magnitude < 2.5)) {
          const glow = backdropContext.createRadialGradient(star.x, star.y, 0, star.x, star.y, star.radius * 4);
          glow.addColorStop(0, `rgba(${color}, 0.2)`);
          glow.addColorStop(1, `rgba(${color}, 0)`);
          backdropContext.fillStyle = glow;
          backdropContext.beginPath();
          backdropContext.arc(star.x, star.y, star.radius * 4, 0, Math.PI * 2);
          backdropContext.fill();
        }
      }
      paint(performance.now());
    }
    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('pagehide', stop);
    window.addEventListener('pageshow', resume);
    document.addEventListener('visibilitychange', resume);
    reducedMotion.addEventListener('change', resume);
    resize();
    resume();
  }
</script>
