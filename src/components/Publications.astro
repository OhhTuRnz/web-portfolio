---
import { scholarProfile } from '../data/publications.js';
import PublicationCard from './PublicationCard.astro';
import { getPublicationGroups } from '../lib/publications';

const groups = getPublicationGroups();
const metrics = [
  { value: scholarProfile.totalCitations, label: 'Citations' },
  { value: scholarProfile.hIndex, label: 'h-index' },
  { value: scholarProfile.i10Index, label: 'i10-index' },
  { value: groups.reduce((total, group) => total + group.entries.length, 0), label: 'Publications' },
];
---
<section id="publications" class="content-section" aria-labelledby="publications-title">
  <div class="section-heading">
    <h2 id="publications-title">Publications</h2>
  </div>
  <dl class="scholar-metrics" aria-label="Google Scholar metrics">
    {metrics.map((metric) => (
      <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>
    ))}
  </dl>
  <div class="publication-years">
    {groups.map(({ year, entries }) => (
      <div class="publication-year">
        <div class="publication-year-heading">
          <h3 class="year-divider"><span>{year}</span></h3>
          {entries.length > 1 && (
            <button type="button" class="publication-toggle" data-publication-toggle
              aria-label={`Other publications from ${year}`} aria-expanded="false"
              aria-controls={`more-publications-${year}`} title={`Other publications from ${year}`}>
              <span class="toggle-plus" aria-hidden="true">+</span>
              <span class="toggle-minus" aria-hidden="true">−</span>
            </button>
          )}
        </div>
        <PublicationCard publication={entries[0]} />
        {entries.length > 1 && (
          <div class="publication-more" id={`more-publications-${year}`} hidden>
            {entries.slice(1).map((publication) => <PublicationCard publication={publication} />)}
          </div>
        )}
      </div>
    ))}
  </div>
  <a class="scholar-profile" href={scholarProfile.profileUrl} target="_blank" rel="noopener noreferrer">
    Full Google Scholar profile <span aria-hidden="true">↗</span>
  </a>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-publication-toggle]').forEach((button) => {
    const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!panel) return;
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      panel.hidden = expanded;
      button.setAttribute('aria-expanded', String(!expanded));
    });
  });
</script>
