---
const isBlog = Astro.url.pathname.startsWith('/blog');
---
<header class="site-header">
  <nav class="site-switch" aria-label="Website">
    <a href="/" aria-current={!isBlog ? 'page' : undefined}>Portfolio</a>
    <a href="/blog/" aria-current={isBlog ? 'page' : undefined}>Blog</a>
  </nav>
</header>
