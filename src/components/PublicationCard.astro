---
import type { Publication } from '../lib/publications';

interface Props { publication: Publication; }
const { publication } = Astro.props;
const typeLabels: Record<string, string> = {
  journal: 'Journal', conference: 'Conference', workshop: 'Workshop', preprint: 'Preprint',
};
const titleLink = publication.scholar_url?.includes('view_op=view_citation')
  ? publication.scholar_url
  : publication.doi || publication.scholar_url;
---
<article class="pub-card">
    <div class="pub-meta">
      <span class="type-badge">{typeLabels[publication.type] ?? publication.type}</span>
      {publication.citations > 0 && (
        <span class="cite-badge">{publication.citations} {publication.citations === 1 ? 'citation' : 'citations'}</span>
      )}
      {publication.pdfUrl && (
        <a class="pub-pdf" href={publication.pdfUrl} target="_blank" rel="noopener noreferrer"
          aria-label={`PDF: ${publication.title}`}>PDF <span aria-hidden="true">↗</span></a>
      )}
    </div>
    <h4 class="pub-title">
      {titleLink ? <a href={titleLink} target="_blank" rel="noopener noreferrer">{publication.title}</a> : publication.title}
    </h4>
    <p class="pub-authors">{publication.authors.join(', ')}</p>
    <p class="pub-venue">{publication.venue}</p>
    {publication.abstract && (
      <details class="pub-abstract">
        <summary aria-label={`Abstract: ${publication.title}`}>
          <span class="when-closed">Abstract</span><span class="when-open">Hide abstract</span>
        </summary>
        <p>{publication.abstract}</p>
      </details>
    )}
</article>
