---
import Header from '../components/Header.astro';
import SectionNav from '../components/SectionNav.astro';
import StarBackground from '../components/StarBackground.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/site.css';

export interface Props {
  title: string;
  description?: string;
  article?: {
    title: string;
    publishedAt: Date;
    updatedAt?: Date;
    image?: string;
  };
}

const { title, description = site.description, article } = Astro.props;
const isBlog = Astro.url.pathname.startsWith('/blog');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const image = new URL(article?.image ?? '/assets/images/carrusk_zen.png', canonical);
const fontKit = import.meta.env.PUBLIC_ADOBE_FONTS_KIT_ID?.trim();
if (fontKit && !/^[a-z0-9]{7}$/i.test(fontKit)) {
  throw new Error('PUBLIC_ADOBE_FONTS_KIT_ID must be the seven-character Adobe Fonts web-project ID.');
}
const structuredData = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description,
  datePublished: article.publishedAt.toISOString(),
  dateModified: (article.updatedAt ?? article.publishedAt).toISOString(),
  mainEntityOfPage: canonical.href,
  image: image.href,
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
} : undefined;
---
<!doctype html>
<html lang="en" data-theme={isBlog ? 'blog' : 'portfolio'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={isBlog ? '#dbbe90' : '#0f172a'} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/carrusk.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href="/blog/rss.xml" />
    {fontKit && <link rel="stylesheet" href={`https://use.typekit.net/${fontKit}.css`} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={site.name} />
    {article && <meta property="article:published_time" content={article.publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <StarBackground />
    <div class="site-shell">
      <Header />
      <slot />
      <Footer />
    </div>
    {!isBlog && <SectionNav />}
  </body>
</html>
