---
import Layout from '../../layouts/Layout.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { getPublishedPosts } from '../../lib/blog';
const posts = await getPublishedPosts();
---
<Layout title="Blog" description="Notes and writing by Alejandro Carrasco.">
  <main id="main-content" class="blog-index">
    <header class="page-heading">
      <h1>Blog</h1>
      <p class="page-description">This is my mind palace, the escape, the urge for my curiosity to tinker. My connection with what exists; therefore I am.</p>
    </header>
    <BlogIndex posts={posts} />
  </main>
</Layout>
